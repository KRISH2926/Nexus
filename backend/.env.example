NODE_ENV=production
HOST=0.0.0.0
PORT=5000
MONGO_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/<database>
MONGO_DB_NAME=nexus_production
JWT_SECRET=<inject-a-unique-secret-of-at-least-32-bytes-from-your-secret-manager>
CORS_ORIGINS=https://nexus.institution.edu
FRONTEND_URL=https://nexus.institution.edu
APP_PUBLIC_URL=https://nexus.institution.edu
SMTP_HOST=<institutional-smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=NEXUS <noreply@institution.edu>
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<inject-from-your-secret-manager>
NEXUS_DEMO_MODE=false
